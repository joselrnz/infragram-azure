#!/bin/sh
# Run an Infragram command for a hook: with the first Python 3.11 or later
# this machine has (python3, python, then the Windows launcher), through the
# skill's launcher, which runs the package this plugin carries. Whatever
# happens -- no Python, no pydantic, an older infragram on the PATH -- the
# hook exits 0: a note on stderr, never a blocked tool call. A finding is the
# JSON the command prints, not an exit status.
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
for python in python3 python "py -3"; do
  if $python -c 'import sys; sys.exit(sys.version_info < (3, 11))' >/dev/null 2>&1; then
    $python "$root/skills/infragram-azure/scripts/infragram.py" "$@"
    status=$?
    [ "$status" -eq 0 ] || echo "infragram: the hook's check did not run (exit $status)" >&2
    exit 0
  fi
done
echo "infragram: no Python 3.11 or later found (python3, python, py -3); the check hook did not run" >&2
exit 0
