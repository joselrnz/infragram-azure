{
  "schema_version": 1,
  "provider": "azure",
  "about": "What each Azure frame kind and component is written as by the Terraform export (infragram.terraform). A component missing here is written as a comment the README lists. Arguments follow the AzureRM provider's schema; a $ value is filled from where the element sits (see infragram/terraform/mapping.py).",
  "terraform": {"name": "azurerm", "source": "hashicorp/azurerm", "version": "~> 4.0"},
  "companions": [{"name": "azuread", "source": "hashicorp/azuread", "version": "~> 3.0", "prefix": "azuread_"}],
  "frames": {
    "group": {"role": "none"},
    "cloud": {"role": "none"},
    "organization": {"role": "account", "note": "A Microsoft Entra tenant: the provider's credentials choose it."},
    "management-group": {"role": "account", "note": "A management group: create it with azurerm_management_group, and move the subscriptions under it, where the platform team manages the hierarchy."},
    "subscription": {"role": "subscription"},
    "region": {"role": "region"},
    "zone": {"role": "none"},
    "resource-group": {
      "role": "resource_group",
      "resources": [
        {"type": "azurerm_resource_group", "args": {"name": "$caption_id", "location": "$location", "tags": "$tags"},
         "module": "azure-resource-group", "module_args": {"name": "$caption_id", "location": "$location", "enable_telemetry": false, "tags": "$tags"}}
      ]
    },
    "network": {
      "role": "network",
      "resources": [
        {"type": "azurerm_virtual_network", "args": {"name": "$caption_id", "location": "$location", "resource_group_name": "$resource_group", "address_space": ["$cidr"], "tags": "$tags"}}
      ]
    },
    "subnet-private": {
      "role": "subnet",
      "resources": [
        {"type": "azurerm_subnet", "args": {"name": "$caption_id", "resource_group_name": "$resource_group", "virtual_network_name": "$network.name", "address_prefixes": ["$cidr"]}}
      ]
    },
    "subnet-public": {
      "role": "subnet",
      "resources": [
        {"type": "azurerm_subnet", "args": {"name": "$caption_id", "resource_group_name": "$resource_group", "virtual_network_name": "$network.name", "address_prefixes": ["$cidr"]}}
      ]
    },
    "cluster": {
      "role": "cluster",
      "resources": [
        {"type": "azurerm_kubernetes_cluster", "args": {
          "name": "$name", "location": "$location", "resource_group_name": "$resource_group", "dns_prefix": "$name:lower54",
          "default_node_pool": {"$block": {"name": "$pool", "vm_size": "$var:vm_size=Standard_D4ds_v5", "node_count": "$var:node_count:number=3", "vnet_subnet_id": "$subnet.id?"}},
          "identity": {"$block": {"type": "SystemAssigned"}},
          "tags": "$tags"},
         "module": "azure-kubernetes-cluster", "module_args": {"name": "$name", "location": "$location", "parent_id": "$resource_group.id", "dns_prefix": "$name:lower54", "default_agent_pool": {"name": "$pool", "vm_size": "$var:vm_size=Standard_D4ds_v5", "count_of": "$var:node_count:number=3", "vnet_subnet_id": "$subnet.id?"}, "enable_telemetry": false, "tags": "$tags"}}
      ]
    }
  },
  "components": {
    "kubernetes-services": {
      "step": "compute", "category": "containers", "item": "kubernetes_node_pool", "plumbing": "node_pool",
      "resources": [
        {"type": "azurerm_kubernetes_cluster_node_pool", "args": {"name": "$pool", "kubernetes_cluster_id": "$cluster.id", "vm_size": "$var:vm_size=Standard_D4ds_v5", "node_count": "$var:node_count:number=3", "vnet_subnet_id": "$subnet.id?", "tags": "$tags"}}
      ]
    },
    "virtual-machine": {
      "step": "compute", "category": "compute", "item": "virtual_machine", "requires": "subnet", "security_group": true, "output": "private_ip_address",
      "resources": [
        {"key": "nic", "type": "azurerm_network_interface", "args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "ip_configuration": {"$block": {"name": "internal", "subnet_id": "$subnet.id", "private_ip_address_allocation": "Dynamic"}}, "tags": "$tags"}},
        {"type": "azurerm_linux_virtual_machine", "args": {
          "name": "$name", "location": "$location", "resource_group_name": "$resource_group", "size": "$var:size=Standard_D2s_v5",
          "admin_username": "$var:admin_username=azureuser", "network_interface_ids": ["$self.nic.id"],
          "admin_ssh_key": {"$block": {"username": "$var:admin_username=azureuser", "public_key": "$var:ssh_public_key"}},
          "os_disk": {"$block": {"caching": "ReadWrite", "storage_account_type": "Premium_LRS"}},
          "source_image_reference": {"$block": {"publisher": "Canonical", "offer": "ubuntu-24_04-lts", "sku": "server", "version": "latest"}},
          "tags": "$tags"}},
        {"key": "nsg", "type": "azurerm_network_security_group", "comment": "Its own network security group: the wires to it are its inbound rules.", "args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "tags": "$tags"},
         "module": "azure-network-security-group", "module_args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "enable_telemetry": false, "tags": "$tags"}},
        {"key": "nsg_link", "type": "azurerm_network_interface_security_group_association", "args": {"network_interface_id": "$self.nic.id", "network_security_group_id": "$self.nsg.id"}},
        {"key": "asg", "type": "azurerm_application_security_group", "comment": "Its own application security group: the rules its wires write name it.", "args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "tags": "$tags"}},
        {"key": "asg_link", "type": "azurerm_network_interface_application_security_group_association", "args": {"network_interface_id": "$self.nic.id", "application_security_group_id": "$self.asg.id"}}
      ]
    },
    "vm-scale-sets": {
      "step": "compute", "category": "compute", "item": "vm_scale_set", "requires": "subnet", "security_group": true,
      "resources": [
        {"key": "nsg", "type": "azurerm_network_security_group", "comment": "Its own network security group: the wires to it are its inbound rules.", "args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "tags": "$tags"},
         "module": "azure-network-security-group", "module_args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "enable_telemetry": false, "tags": "$tags"}},
        {"key": "asg", "type": "azurerm_application_security_group", "comment": "Its own application security group: the rules its wires write name it.", "args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "tags": "$tags"}},
        {"type": "azurerm_linux_virtual_machine_scale_set", "args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "sku": "$var:sku=Standard_D2s_v5", "instances": "$var:instances:number=2", "admin_username": "$var:admin_username=azureuser", "admin_ssh_key": {"$block": {"username": "$var:admin_username=azureuser", "public_key": "$var:ssh_public_key"}}, "source_image_reference": {"$block": {"publisher": "Canonical", "offer": "ubuntu-24_04-lts", "sku": "server", "version": "latest"}}, "os_disk": {"$block": {"caching": "ReadWrite", "storage_account_type": "Premium_LRS"}}, "network_interface": {"$block": {"name": "nic", "primary": true, "ip_configuration": {"$block": {"name": "internal", "primary": true, "subnet_id": "$subnet.id", "application_security_group_ids": ["$self.asg.id"], "application_gateway_backend_address_pool_ids": "$backend_pools?"}}, "network_security_group_id": "$self.nsg.id"}}, "tags": "$tags"}}
      ]
    },
    "app-services": {
      "step": "compute", "category": "compute", "item": "app_service", "output": "default_hostname", "private_link": {"subresource": "sites", "zone": "privatelink.azurewebsites.net"}, "ci_access": {"roles": ["Website Contributor"]},
      "resources": [
        {"key": "plan", "type": "azurerm_service_plan", "args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "os_type": "Linux", "sku_name": "$var:sku_name=P1v3", "tags": "$tags"},
         "module": "azure-service-plan", "module_args": {"name": "$name", "location": "$location", "parent_id": "$resource_group.id", "os_type": "Linux", "sku_name": "$var:sku_name=P1v3", "worker_count": 1, "zone_balancing_enabled": false, "enable_telemetry": false, "tags": "$tags"}},
        {"type": "azurerm_linux_web_app", "args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "service_plan_id": "$self.plan.id", "https_only": true, "site_config": {"$block": {}}, "tags": "$tags"},
         "module": "azure-web-site", "module_args": {"name": "$name", "location": "$location", "parent_id": "$resource_group.id", "service_plan_resource_id": "$self.plan.id", "kind": "webapp", "os_type": "Linux", "https_only": true, "public_network_access_enabled": true, "enable_telemetry": false, "tags": "$tags"}}
      ]
    },
    "load-balancers": {
      "step": "edge", "category": "edge", "item": "load_balancer", "requires": "subnet", "output": "private_ip_address",
      "resources": [
        {"type": "azurerm_lb", "args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "sku": "Standard", "frontend_ip_configuration": {"$block": {"name": "frontend", "subnet_id": "$subnet.id", "private_ip_address_allocation": "Dynamic"}}, "tags": "$tags"},
         "module": "azure-load-balancer", "module_args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "frontend_ip_configurations": {"frontend": {"name": "frontend", "frontend_private_ip_subnet_resource_id": "$subnet.id", "frontend_private_ip_address_allocation": "Dynamic", "zones": ["None"]}}, "enable_telemetry": false, "tags": "$tags"}}
      ]
    },
    "application-gateways": {
      "step": "edge", "category": "edge", "item": "application_gateway", "requires": "subnet", "plumbing": "application_gateway",
      "resources": [
        {"key": "ip", "type": "azurerm_public_ip", "args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "allocation_method": "Static", "sku": "Standard", "tags": "$tags"},
         "module": "azure-public-ip", "module_args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "allocation_method": "Static", "sku": "Standard", "zones": null, "enable_telemetry": false, "tags": "$tags"}},
        {"type": "azurerm_application_gateway", "args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "firewall_policy_id": "$gateway.waf_policy?", "sku": {"$block": {"name": "$gateway.tier", "tier": "$gateway.tier", "capacity": "$var:capacity:number=2"}}, "identity": {"$block": {"type": "UserAssigned", "identity_ids": ["$var:identity_id"]}, "$when": "https"}, "gateway_ip_configuration": {"$block": {"name": "gateway", "subnet_id": "$subnet.id"}}, "frontend_port": {"$block": {"name": "$gateway.listener", "port": "$gateway.listener_port"}}, "frontend_ip_configuration": {"$block": {"name": "public", "public_ip_address_id": "$self.ip.id"}}, "backend_address_pool": {"$block": {"name": "backend"}}, "backend_http_settings": {"$block": {"name": "backend", "cookie_based_affinity": "Disabled", "port": "$gateway.backend_port", "protocol": "$gateway.backend_protocol", "request_timeout": 60}}, "ssl_certificate": {"$block": {"name": "tls", "key_vault_secret_id": "$var:certificate_secret_id"}, "$when": "https"}, "http_listener": {"$block": {"name": "$gateway.listener", "frontend_ip_configuration_name": "public", "frontend_port_name": "$gateway.listener", "protocol": "$gateway.listener_protocol", "ssl_certificate_name": "$gateway.certificate?"}}, "request_routing_rule": {"$block": {"name": "default", "priority": 100, "rule_type": "Basic", "http_listener_name": "$gateway.listener", "backend_address_pool_name": "backend", "backend_http_settings_name": "backend"}}, "tags": "$tags"}}
      ]
    },
    "firewalls": {
      "step": "security", "category": "security", "item": "firewall", "requires": "subnet", "subnet_name": "AzureFirewallSubnet",
      "resources": [
        {"key": "ip", "type": "azurerm_public_ip", "args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "allocation_method": "Static", "sku": "Standard", "tags": "$tags"},
         "module": "azure-public-ip", "module_args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "allocation_method": "Static", "sku": "Standard", "zones": null, "enable_telemetry": false, "tags": "$tags"}},
        {"type": "azurerm_firewall", "args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "sku_name": "AZFW_VNet", "sku_tier": "$var:sku_tier=Standard", "ip_configuration": {"$block": {"name": "configuration", "subnet_id": "$subnet.id", "public_ip_address_id": "$self.ip.id"}}, "tags": "$tags"},
         "module": "azure-firewall", "module_args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "firewall_sku_name": "AZFW_VNet", "firewall_sku_tier": "$var:sku_tier=Standard", "firewall_ip_configuration": [{"name": "configuration", "subnet_id": "$subnet.id", "public_ip_address_id": "$self.ip.id"}], "firewall_zones": null, "enable_telemetry": false, "tags": "$tags"}}
      ]
    },
    "bastions": {
      "step": "security", "category": "security", "item": "bastion_host", "requires": "subnet", "subnet_name": "AzureBastionSubnet",
      "resources": [
        {"key": "ip", "type": "azurerm_public_ip", "in_modules": false, "args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "allocation_method": "Static", "sku": "Standard", "tags": "$tags"}},
        {"type": "azurerm_bastion_host", "args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "ip_configuration": {"$block": {"name": "configuration", "subnet_id": "$subnet.id", "public_ip_address_id": "$self.ip.id"}}, "tags": "$tags"},
         "module": "azure-bastion", "module_args": {"name": "$name", "location": "$location", "parent_id": "$resource_group.id", "ip_configuration": {"name": "configuration", "subnet_id": "$subnet.id", "create_public_ip": true, "public_ip_address_name": "$name"}, "zones": [], "enable_telemetry": false, "tags": "$tags"}}
      ]
    },
    "virtual-network-gateways": {
      "step": "network", "category": "network", "item": "virtual_network_gateway", "requires": "subnet", "subnet_name": "GatewaySubnet", "note": "Its type is Vpn or ExpressRoute.",
      "resources": [
        {"key": "ip", "type": "azurerm_public_ip", "args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "allocation_method": "Static", "sku": "Standard", "tags": "$tags"},
         "module": "azure-public-ip", "module_args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "allocation_method": "Static", "sku": "Standard", "zones": null, "enable_telemetry": false, "tags": "$tags"}},
        {"type": "azurerm_virtual_network_gateway", "args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "type": "$var:type=Vpn", "sku": "$var:sku=VpnGw1AZ", "ip_configuration": {"$block": {"name": "configuration", "subnet_id": "$subnet.id", "public_ip_address_id": "$self.ip.id"}}, "tags": "$tags"}}
      ]
    },
    "expressroute-circuits": {
      "step": "network", "category": "network", "item": "expressroute_circuit",
      "resources": [
        {"type": "azurerm_express_route_circuit", "args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "service_provider_name": "$var:service_provider_name", "peering_location": "$var:peering_location", "bandwidth_in_mbps": "$var:bandwidth_in_mbps:number=1000", "sku": {"$block": {"tier": "Standard", "family": "MeteredData"}}, "tags": "$tags"},
         "module": "azure-expressroute-circuit", "module_args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "service_provider_name": "$var:service_provider_name", "peering_location": "$var:peering_location", "bandwidth_in_mbps": "$var:bandwidth_in_mbps:number=1000", "sku": {"tier": "Standard", "family": "MeteredData"}, "enable_telemetry": false, "tags": "$tags"}}
      ]
    },
    "private-endpoints": {
      "step": "network", "category": "network", "item": "private_endpoint", "requires": "subnet", "plumbing": "private_endpoint",
      "resources": [
        {"type": "azurerm_private_endpoint", "args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "subnet_id": "$subnet.id", "private_service_connection": {"$block": {"name": "connection", "is_manual_connection": false, "private_connection_resource_id": "$link.id", "subresource_names": "$link.subresources"}}, "private_dns_zone_group": {"$block": {"name": "default", "private_dns_zone_ids": "$link.zones"}, "$when": "link"}, "tags": "$tags"},
         "module": "azure-private-endpoint", "module_args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "subnet_resource_id": "$subnet.id", "network_interface_name": "$name", "private_connection_resource_id": "$link.id", "subresource_names": "$link.subresources", "private_dns_zone_resource_ids": "$link.zones?", "enable_telemetry": false, "tags": "$tags"}}
      ]
    },
    "dns-private-resolver": {
      "step": "network", "category": "dns", "item": "private_dns_resolver", "requires": "network",
      "resources": [
        {"type": "azurerm_private_dns_resolver", "args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "virtual_network_id": "$network.id", "tags": "$tags"},
         "module": "azure-dns-resolver", "module_args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "virtual_network_resource_id": "$network.id", "enable_telemetry": false, "tags": "$tags"}}
      ]
    },
    "dns-zones": {
      "step": "edge", "category": "dns", "item": "dns_zone", "note": "A private link zone is an azurerm_private_dns_zone instead.",
      "resources": [
        {"type": "azurerm_dns_zone", "args": {"name": "$var:domain_name", "resource_group_name": "$resource_group", "tags": "$tags"},
         "module": "azure-dns-zone", "module_args": {"name": "$var:domain_name", "resource_group_name": "$resource_group", "enable_telemetry": false, "tags": "$tags"}}
      ]
    },
    "front-door-and-cdn-profiles": {
      "step": "edge", "category": "edge", "item": "front_door_profile",
      "resources": [
        {"type": "azurerm_cdn_frontdoor_profile", "args": {"name": "$name", "resource_group_name": "$resource_group", "sku_name": "$var:sku_name=Standard_AzureFrontDoor", "tags": "$tags"},
         "module": "azure-cdn-profile", "module_args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "sku": "$var:sku_name=Standard_AzureFrontDoor", "enable_telemetry": false, "tags": "$tags"}}
      ]
    },
    "ddos-protection-plans": {
      "step": "security", "category": "security", "item": "ddos_protection_plan",
      "resources": [
        {"type": "azurerm_network_ddos_protection_plan", "args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "tags": "$tags"},
         "module": "azure-ddos-protection-plan", "module_args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "enable_telemetry": false, "tags": "$tags"}}
      ]
    },
    "key-vaults": {
      "step": "security", "category": "security", "item": "key_vault", "output": "vault_uri", "private_link": {"subresource": "vault", "zone": "privatelink.vaultcore.azure.net"}, "ci_access": {"roles": ["Key Vault Secrets User"]},
      "resources": [
        {"type": "azurerm_key_vault", "args": {"name": "$name:lower24", "location": "$location", "resource_group_name": "$resource_group", "tenant_id": "$tenant_id", "sku_name": "standard", "purge_protection_enabled": true, "tags": "$tags"},
         "module": "azure-key-vault", "module_args": {"name": "$name:lower24", "location": "$location", "resource_group_name": "$resource_group", "tenant_id": "$tenant_id", "sku_name": "standard", "purge_protection_enabled": true, "network_acls": null, "enable_telemetry": false, "tags": "$tags"}}
      ]
    },
    "managed-identities": {
      "step": "security", "category": "security", "item": "managed_identity", "output": "client_id", "plumbing": "github_oidc",
      "resources": [
        {"type": "azurerm_user_assigned_identity", "args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "tags": "$tags"},
         "module": "azure-user-assigned-identity", "module_args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "enable_telemetry": false, "tags": "$tags"}}
      ],
      "federated": [
        {"type": "azurerm_user_assigned_identity", "args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "tags": "$tags"},
         "module": "azure-user-assigned-identity", "module_args": {"name": "$name", "location": "$location", "resource_group_name": "$resource_group", "enable_telemetry": false, "tags": "$tags"}},
        {"key": "github", "type": "azurerm_federated_identity_credential", "comment": "GitHub's workflows sign in as it: a token from its issuer, no secret.", "args": {"name": "github-actions", "audience": ["api://AzureADTokenExchange"], "issuer": "https://token.actions.githubusercontent.com", "subject": "$github.subject", "user_assigned_identity_id": "$self.main.id"}}
      ]
    },
    "entra-id": {
      "step": "security", "category": "security", "item": "entra_tenant", "resources": [],
      "note": "The tenant is there already: Terraform signs in to it and writes the app registrations and service principals drawn in it."
    },
    "app-registrations": {
      "step": "security", "category": "security", "item": "app_registration", "output": "client_id", "plumbing": "github_oidc", "principal": "",
      "resources": [
        {"type": "azuread_application", "args": {"display_name": "$name"}}
      ],
      "federated": [
        {"type": "azuread_application", "args": {"display_name": "$name"}},
        {"key": "github", "type": "azuread_application_federated_identity_credential", "comment": "GitHub's workflows sign in as it: a token from its issuer, no secret.", "args": {"application_id": "$self.main.id", "display_name": "github-actions", "audiences": ["api://AzureADTokenExchange"], "issuer": "https://token.actions.githubusercontent.com", "subject": "$github.subject"}}
      ]
    },
    "enterprise-applications": {
      "step": "security", "category": "security", "item": "service_principal", "output": "object_id", "plumbing": "service_principal", "principal": "object_id",
      "resources": [
        {"type": "azuread_service_principal", "comment": "The app registration's identity in the tenant: the roles are assigned to it.", "args": {"client_id": "$wired.app-registrations.main.client_id"}}
      ]
    },
    "microsoft-defender-for-cloud": {
      "step": "security", "category": "security", "item": "defender_plan",
      "resources": [
        {"type": "azurerm_security_center_subscription_pricing", "args": {"tier": "Standard", "resource_type": "$var:resource_type=VirtualMachines"}}
      ]
    },
    "policy": {
      "step": "security", "category": "security", "item": "policy_assignment", "note": "Assign each built-in or custom definition the diagram's policy stands for.",
      "resources": [
        {"type": "azurerm_subscription_policy_assignment", "args": {"name": "$name", "policy_definition_id": "$var:policy_definition_id", "subscription_id": "$var:subscription_resource_id"}}
      ]
    },
    "azure-sentinel": {
      "step": "security", "category": "security", "item": "sentinel_workspace",
      "resources": [
        {"type": "azurerm_sentinel_log_analytics_workspace_onboarding", "args": {"workspace_id": "$var:workspace_id"}}
      ]
    },
    "sql-database": {
      "step": "data", "category": "database", "item": "sql_server", "output": "server.fully_qualified_domain_name",
      "private_link": {"resource": "server", "subresource": "sqlServer", "zone": "privatelink.database.windows.net"},
      "resources": [
