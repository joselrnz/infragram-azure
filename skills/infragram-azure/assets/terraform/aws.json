{
  "schema_version": 1,
  "provider": "aws",
  "about": "What each AWS frame kind and component is written as by the Terraform export (infragram.terraform). A component missing here is written as a comment the README lists. Arguments follow the AWS provider's schema; a $ value is filled from where the element sits (see infragram/terraform/mapping.py).",
  "terraform": {"name": "aws", "source": "hashicorp/aws", "version": "~> 6.0"},
  "frames": {
    "group": {"role": "none"},
    "cloud": {"role": "none"},
    "organization": {"role": "account", "note": "An AWS organization: the provider's credentials and the account structure are managed outside this configuration."},
    "account": {"role": "account", "note": "An AWS account: the provider's credentials choose it."},
    "region": {"role": "region"},
    "vpc": {
      "role": "network",
      "resources": [
        {"type": "aws_vpc", "args": {"cidr_block": "$cidr", "enable_dns_support": true, "enable_dns_hostnames": true, "tags": "$tags_named"}}
      ]
    },
    "zone": {"role": "zone"},
    "subnet-public": {
      "role": "subnet",
      "resources": [
        {"type": "aws_subnet", "args": {"vpc_id": "$network.id", "cidr_block": "$cidr", "availability_zone": "$zone?", "map_public_ip_on_launch": true, "tags": "$tags_named"}}
      ]
    },
    "subnet-private": {
      "role": "subnet",
      "resources": [
        {"type": "aws_subnet", "args": {"vpc_id": "$network.id", "cidr_block": "$cidr", "availability_zone": "$zone?", "tags": "$tags_named"}}
      ]
    },
    "security-group": {
      "role": "security_group",
      "resources": [
        {"type": "aws_security_group", "args": {"name": "$name", "description": "$caption", "vpc_id": "$network.id", "tags": "$tags_named"}}
      ]
    },
    "auto-scaling": {"role": "none"},
    "location": {"role": "outside"},
    "site": {"role": "outside"}
  },
  "components": {
    "ec2": {
      "step": "compute", "category": "compute", "item": "ec2_instance", "requires": "subnet", "security_group": true, "output": "private_ip",
      "resources": [
        {"type": "aws_instance", "args": {"ami": "$var:ami", "instance_type": "$var:instance_type=t3.micro", "subnet_id": "$subnet.id", "vpc_security_group_ids": "$security_groups", "tags": "$tags_named"},
         "module": "aws-ec2-instance", "module_args": {"name": "$name", "ami": "$var:ami", "instance_type": "$var:instance_type=t3.micro", "subnet_id": "$subnet.id", "vpc_security_group_ids": "$security_groups", "create_security_group": false}}
      ]
    },
    "ec2-auto-scaling": {
      "step": "compute", "category": "compute", "item": "autoscaling_group", "requires": "subnet", "security_group": true, "output": "name",
      "resources": [
        {"key": "template", "type": "aws_launch_template", "in_modules": false, "args": {"name": "$name", "image_id": "$var:ami", "instance_type": "$var:instance_type=t3.micro", "vpc_security_group_ids": "$security_groups", "tag_specifications": {"$block": {"resource_type": "instance", "tags": "$tags_named"}}, "tags": "$tags_named"}},
        {"type": "aws_autoscaling_group", "args": {"name": "$name", "desired_capacity": "$var:desired_capacity:number=1", "min_size": "$var:min_size:number=1", "max_size": "$var:max_size:number=2", "vpc_zone_identifier": "$subnets.id", "launch_template": {"$block": {"id": "$self.template.id", "version": "$raw:\"$Latest\""}}, "tag": {"$block": {"key": "Name", "value": "$name", "propagate_at_launch": true}}},
         "module": "aws-autoscaling", "module_args": {"name": "$name", "use_name_prefix": false, "min_size": "$var:min_size:number=1", "max_size": "$var:max_size:number=2", "desired_capacity": "$var:desired_capacity:number=1", "vpc_zone_identifier": "$subnets.id", "image_id": "$var:ami", "instance_type": "$var:instance_type=t3.micro", "security_groups": "$security_groups", "tags": "$tags_named"}}
      ]
    },
    "elastic-load-balancing": {
      "step": "edge", "category": "edge", "item": "load_balancer", "requires": "subnet", "security_group": true, "port": 443, "output": "dns_name", "plumbing": "load_balancer",
      "resources": [
        {"type": "aws_lb", "args": {"name": "$name:max32", "load_balancer_type": "application", "internal": "$internal", "subnets": "$subnets.id", "security_groups": "$security_groups", "tags": "$tags_named"},
         "module": "aws-alb", "module_args": {"name": "$name:max32", "load_balancer_type": "application", "internal": "$internal", "vpc_id": "$network.id", "subnets": "$subnets.id", "security_groups": "$security_groups", "create_security_group": false, "enable_deletion_protection": false, "tags": "$tags_named"}}
      ]
    },
    "rds": {
      "step": "data", "category": "database", "item": "rds_instance", "requires": "subnet", "security_group": true, "port": 5432, "output": "address",
      "resources": [
        {"key": "subnets", "type": "aws_db_subnet_group", "in_modules": false, "args": {"name": "$name:lower", "subnet_ids": "$subnets.id", "tags": "$tags_named"}},
        {"type": "aws_db_instance", "args": {"identifier": "$name:lower", "engine": "$var:engine=postgres", "instance_class": "$var:instance_class=db.t4g.medium", "multi_az": "$var:multi_az:bool=false", "allocated_storage": "$var:allocated_storage:number=20", "username": "$var:username=dbadmin", "manage_master_user_password": true, "final_snapshot_identifier": "$name:lower+final", "db_subnet_group_name": "$self.subnets.name", "vpc_security_group_ids": "$security_groups", "tags": "$tags_named"},
         "module": "aws-rds", "module_args": {"identifier": "$name:lower", "engine": "$var:engine=postgres", "instance_class": "$var:instance_class=db.t4g.medium", "multi_az": "$var:multi_az:bool=false", "allocated_storage": "$var:allocated_storage:number=20", "username": "$var:username=dbadmin", "manage_master_user_password": true, "create_db_subnet_group": true, "db_subnet_group_name": "$name:lower", "db_subnet_group_use_name_prefix": false, "subnet_ids": "$subnets.id", "vpc_security_group_ids": "$security_groups", "create_db_parameter_group": false, "create_db_option_group": false}}
      ]
    },
    "aurora": {
      "step": "data", "category": "database", "item": "aurora_cluster", "requires": "subnet", "security_group": true, "port": 5432, "output": "endpoint",
      "resources": [
        {"key": "subnets", "type": "aws_db_subnet_group", "in_modules": false, "args": {"name": "$name:lower", "subnet_ids": "$subnets.id", "tags": "$tags_named"}},
        {"type": "aws_rds_cluster", "args": {"cluster_identifier": "$name:lower", "engine": "$var:engine=aurora-postgresql", "master_username": "$var:username=dbadmin", "manage_master_user_password": true, "final_snapshot_identifier": "$name:lower+final", "db_subnet_group_name": "$self.subnets.name", "vpc_security_group_ids": "$security_groups", "tags": "$tags_named"},
         "module": "aws-rds-aurora", "module_args": {"name": "$name:lower", "engine": "$var:engine=aurora-postgresql", "master_username": "$var:username=dbadmin", "manage_master_user_password": true, "final_snapshot_identifier": "$name:lower+final", "create_db_subnet_group": true, "db_subnet_group_name": "$name:lower", "subnets": "$subnets.id", "create_security_group": false, "vpc_security_group_ids": "$security_groups", "instances": {"writer": {"instance_class": "$var:instance_class=db.r6g.large"}}, "tags": "$tags_named"}},
        {"key": "writer", "type": "aws_rds_cluster_instance", "in_modules": false, "args": {"identifier": "$name:lower", "cluster_identifier": "$self.main.id", "engine": "$self.main.engine", "instance_class": "$var:instance_class=db.r6g.large", "tags": "$tags_named"}}
      ]
    },
    "elasticache": {
      "step": "data", "category": "database", "item": "elasticache_cluster", "requires": "subnet", "security_group": true, "port": 6379, "output": "primary_endpoint_address",
      "resources": [
        {"key": "subnets", "type": "aws_elasticache_subnet_group", "in_modules": false, "args": {"name": "$name:lower", "subnet_ids": "$subnets.id"}},
        {"type": "aws_elasticache_replication_group", "args": {"replication_group_id": "$name:lower40", "description": "$caption", "engine": "valkey", "node_type": "$var:node_type=cache.t4g.small", "num_cache_clusters": "$var:nodes:number=2", "subnet_group_name": "$self.subnets.name", "security_group_ids": "$security_groups", "tags": "$tags_named"},
         "module": "aws-elasticache", "module_args": {"replication_group_id": "$name:lower40", "description": "$caption", "engine": "valkey", "node_type": "$var:node_type=cache.t4g.small", "num_cache_clusters": "$var:nodes:number=2", "create_subnet_group": true, "subnet_group_name": "$name:lower", "subnet_ids": "$subnets.id", "create_security_group": false, "security_group_ids": "$security_groups", "log_delivery_configuration": {}, "tags": "$tags_named"}}
      ]
    },
    "efs": {
      "step": "data", "category": "storage", "item": "efs_file_system", "requires": "subnet", "security_group": true, "port": 2049, "output": "dns_name",
      "resources": [
        {"type": "aws_efs_file_system", "args": {"creation_token": "$name", "encrypted": true, "tags": "$tags_named"},
         "module": "aws-efs", "module_args": {"name": "$name", "creation_token": "$name", "encrypted": true, "create_security_group": false, "mount_targets": {"main": {"subnet_id": "$subnet.id", "security_groups": "$security_groups"}}, "tags": "$tags_named"}},
        {"key": "mount", "type": "aws_efs_mount_target", "in_modules": false, "args": {"file_system_id": "$self.main.id", "subnet_id": "$subnet.id", "security_groups": "$security_groups"}}
      ]
    },
    "managed-streaming-for-apache-kafka": {
      "step": "data", "category": "messaging", "item": "msk_cluster", "requires": "subnet", "security_group": true, "port": 9092, "output": "bootstrap_brokers_tls",
      "resources": [
        {"type": "aws_msk_cluster", "args": {"cluster_name": "$name", "kafka_version": "$var:kafka_version=3.7.x", "number_of_broker_nodes": "$var:broker_nodes:number=2", "broker_node_group_info": {"$block": {"client_subnets": "$subnets.id", "instance_type": "$var:broker_instance_type=kafka.m7g.large", "security_groups": "$security_groups"}}, "tags": "$tags_named"},
         "module": "aws-msk", "module_args": {"name": "$name", "kafka_version": "$var:kafka_version=3.7.x", "number_of_broker_nodes": "$var:broker_nodes:number=2", "broker_node_client_subnets": "$subnets.id", "broker_node_instance_type": "$var:broker_instance_type=kafka.m7g.large", "broker_node_security_groups": "$security_groups", "create_cloudwatch_log_group": false, "create_schema_registry": false, "tags": "$tags_named"}}
      ]
    },
    "vpc-internet-gateway": {
      "step": "network", "category": "network", "item": "internet_gateway", "requires": "network", "plumbing": "internet_gateway",
      "resources": [
        {"type": "aws_internet_gateway", "args": {"vpc_id": "$network.id", "tags": "$tags_named"}}
      ]
    },
    "vpc-nat-gateway": {
      "step": "network", "category": "network", "item": "nat_gateway", "requires": "subnet", "plumbing": "nat_gateway",
      "resources": [
        {"key": "eip", "type": "aws_eip", "args": {"domain": "vpc", "tags": "$tags_named"}},
        {"type": "aws_nat_gateway", "args": {"allocation_id": "$self.eip.id", "subnet_id": "$subnet.id", "tags": "$tags_named"}}
      ]
    },
    "vpc-endpoints": {
      "step": "network", "category": "network", "item": "vpc_endpoint", "requires": "subnet", "security_group": true, "port": 443,
      "resources": [
        {"type": "aws_vpc_endpoint", "args": {"vpc_id": "$network.id", "service_name": "$var:service_name", "vpc_endpoint_type": "Interface", "subnet_ids": "$subnets.id", "security_group_ids": "$security_groups", "private_dns_enabled": true, "tags": "$tags_named"},
         "module": "aws-vpc-endpoints", "module_args": {"vpc_id": "$network.id", "subnet_ids": "$subnets.id", "security_group_ids": "$security_groups", "endpoints": {"endpoint": {"service_name": "$var:service_name", "private_dns_enabled": true, "tags": {"Name": "$name"}}}}}
      ]
    },
    "privatelink": {
      "step": "network", "category": "network", "item": "privatelink_endpoint", "requires": "subnet", "security_group": true, "port": 443,
      "resources": [
        {"type": "aws_vpc_endpoint", "args": {"vpc_id": "$network.id", "service_name": "$var:service_name", "vpc_endpoint_type": "Interface", "subnet_ids": "$subnets.id", "security_group_ids": "$security_groups", "private_dns_enabled": true, "tags": "$tags_named"},
         "module": "aws-vpc-endpoints", "module_args": {"vpc_id": "$network.id", "subnet_ids": "$subnets.id", "security_group_ids": "$security_groups", "endpoints": {"endpoint": {"service_name": "$var:service_name", "private_dns_enabled": true, "tags": {"Name": "$name"}}}}}
      ]
    },
    "network-firewall": {
      "step": "security", "category": "security", "item": "network_firewall", "requires": "subnet",
      "resources": [
        {"type": "aws_networkfirewall_firewall", "args": {"name": "$name", "firewall_policy_arn": "$var:firewall_policy_arn", "vpc_id": "$network.id", "subnet_mapping": {"$block": {"subnet_id": "$subnet.id"}}, "tags": "$tags_named"},
         "module": "aws-network-firewall", "module_args": {"name": "$name", "firewall_policy_arn": "$var:firewall_policy_arn", "vpc_id": "$network.id", "subnet_mapping": {"main": {"subnet_id": "$subnet.id"}}, "delete_protection": false, "subnet_change_protection": false, "tags": "$tags_named"}}
      ]
    },
    "site-to-site-vpn": {
      "step": "network", "category": "network", "item": "vpn_connection",
      "resources": [
        {"key": "customer", "type": "aws_customer_gateway", "args": {"bgp_asn": "$var:customer_bgp_asn=65000", "ip_address": "$var:customer_ip_address", "type": "ipsec.1", "tags": "$tags_named"}},
        {"key": "gateway", "type": "aws_vpn_gateway", "args": {"vpc_id": "$network.id?", "tags": "$tags_named"}},
        {"type": "aws_vpn_connection", "args": {"customer_gateway_id": "$self.customer.id", "vpn_gateway_id": "$self.gateway.id", "type": "ipsec.1", "tags": "$tags_named"},
         "module": "aws-vpn-gateway", "module_args": {"customer_gateway_id": "$self.customer.id", "vpn_gateway_id": "$self.gateway.id", "vpc_id": "$self.gateway.vpc_id", "create_vpn_gateway_attachment": false, "tags": "$tags_named"}}
      ]
    },
    "direct-connect": {
      "step": "network", "category": "network", "item": "direct_connect_connection",
      "resources": [
        {"type": "aws_dx_connection", "args": {"name": "$name", "bandwidth": "$var:bandwidth=1Gbps", "location": "$var:location", "tags": "$tags_named"}}
      ]
    },
    "transit-gateway": {
      "step": "network", "category": "network", "item": "transit_gateway", "note": "Attach each VPC it joins with an aws_ec2_transit_gateway_vpc_attachment.",
      "resources": [
        {"type": "aws_ec2_transit_gateway", "args": {"description": "$caption", "tags": "$tags_named"},
         "module": "aws-transit-gateway", "module_args": {"name": "$name", "description": "$caption", "create_tgw_routes": false, "share_tgw": false, "tags": "$tags_named"}}
      ]
    },
    "route-53": {
      "step": "edge", "category": "dns", "item": "route53_zone", "output": "zone_id",
      "resources": [
        {"type": "aws_route53_zone", "args": {"name": "$var:domain_name", "tags": "$tags_named"},
         "module": "aws-route53", "module_args": {"name": "$var:domain_name"}}
      ]
    },
    "certificate-manager": {
      "step": "edge", "category": "edge", "item": "certificate", "output": "arn",
      "resources": [
        {"type": "aws_acm_certificate", "args": {"domain_name": "$var:domain_name", "validation_method": "DNS", "tags": "$tags_named"},
         "module": "aws-acm", "module_args": {"domain_name": "$var:domain_name", "validation_method": "DNS", "create_route53_records": false, "validate_certificate": false, "tags": "$tags_named"}}
      ]
    },
    "api-gateway": {
      "step": "edge", "category": "edge", "item": "api_gateway", "output": "api_endpoint",
      "resources": [
        {"type": "aws_apigatewayv2_api", "args": {"name": "$name", "protocol_type": "HTTP", "tags": "$tags_named"},
         "module": "aws-apigateway-v2", "module_args": {"name": "$name", "protocol_type": "HTTP", "create_domain_name": false, "stage_access_log_settings": null, "tags": "$tags_named"}}
      ]
    },
    "shield": {
      "step": "security", "category": "security", "item": "shield_protection",
      "resources": [
        {"type": "aws_shield_protection", "args": {"name": "$name", "resource_arn": "$var:resource_arn", "tags": "$tags_named"}}
      ]
    },
    "simple-storage-service": {
      "step": "data", "category": "storage", "item": "s3_bucket", "output": "bucket", "ci_access": {"statements": [{"actions": ["s3:ListBucket"], "resources": ["arn"]}, {"actions": ["s3:DeleteObject", "s3:GetObject", "s3:PutObject"], "resources": ["arn/*"]}]},
      "resources": [
        {"type": "aws_s3_bucket", "args": {"bucket": "$name:lower", "tags": "$tags_named"},
         "module": "aws-s3-bucket", "module_args": {"bucket": "$name:lower", "versioning": {"enabled": true}, "tags": "$tags_named"}},
        {"key": "versioning", "type": "aws_s3_bucket_versioning", "in_modules": false, "args": {"bucket": "$self.main.id", "versioning_configuration": {"$block": {"status": "Enabled"}}}},
        {"key": "public_access", "type": "aws_s3_bucket_public_access_block", "in_modules": false, "args": {"bucket": "$self.main.id", "block_public_acls": true, "block_public_policy": true, "ignore_public_acls": true, "restrict_public_buckets": true}}
      ]
    },
    "simple-storage-service-glacier": {
      "step": "data", "category": "storage", "item": "glacier_vault",
      "resources": [
        {"type": "aws_glacier_vault", "args": {"name": "$name", "tags": "$tags_named"}}
      ]
    },
    "dynamodb": {
      "step": "data", "category": "database", "item": "dynamodb_table", "output": "arn",
      "resources": [
        {"type": "aws_dynamodb_table", "args": {"name": "$name", "billing_mode": "PAY_PER_REQUEST", "hash_key": "id", "attribute": {"$block": {"name": "id", "type": "S"}}, "tags": "$tags_named"},
         "module": "aws-dynamodb-table", "module_args": {"name": "$name", "billing_mode": "PAY_PER_REQUEST", "hash_key": "id", "attributes": [{"name": "id", "type": "S"}], "tags": "$tags_named"}}
      ]
    },
    "athena": {
      "step": "data", "category": "analytics", "item": "athena_workgroup",
      "resources": [
        {"type": "aws_athena_workgroup", "args": {"name": "$name", "tags": "$tags_named"}}
      ]
    },
    "transfer-family": {
      "step": "data", "category": "storage", "item": "transfer_server", "output": "endpoint",
      "resources": [
        {"type": "aws_transfer_server", "args": {"identity_provider_type": "SERVICE_MANAGED", "endpoint_type": "PUBLIC", "tags": "$tags_named"}}
      ]
    },
    "simple-queue-service": {
      "step": "data", "category": "messaging", "item": "sqs_queue", "output": "url",
      "resources": [
        {"type": "aws_sqs_queue", "args": {"name": "$name", "tags": "$tags_named"},
         "module": "aws-sqs", "module_args": {"name": "$name", "tags": "$tags_named"}}
      ]
    },
    "simple-notification-service": {
      "step": "data", "category": "messaging", "item": "sns_topic", "output": "arn",
      "resources": [
        {"type": "aws_sns_topic", "args": {"name": "$name", "tags": "$tags_named"},
         "module": "aws-sns", "module_args": {"name": "$name", "tags": "$tags_named"}}
      ]
    },
    "elastic-container-registry": {
      "step": "compute", "category": "containers", "item": "ecr_repository", "output": "repository_url", "ci_access": {"statements": [{"actions": ["ecr:GetAuthorizationToken"], "resources": ["*"]}, {"actions": ["ecr:BatchCheckLayerAvailability", "ecr:BatchGetImage", "ecr:CompleteLayerUpload", "ecr:GetDownloadUrlForLayer", "ecr:InitiateLayerUpload", "ecr:PutImage", "ecr:UploadLayerPart"], "resources": ["arn"]}]},
      "resources": [
        {"type": "aws_ecr_repository", "args": {"name": "$name:lower", "image_scanning_configuration": {"$block": {"scan_on_push": true}}, "tags": "$tags_named"},
         "module": "aws-ecr", "module_args": {"repository_name": "$name:lower", "repository_image_scan_on_push": true, "create_lifecycle_policy": false, "create_repository_policy": false, "attach_repository_policy": false, "tags": "$tags_named"}}
      ]
    },
    "elastic-container-service": {
      "step": "compute", "category": "containers", "item": "ecs_cluster", "output": "arn", "ci_access": {"statements": [{"actions": ["ecs:DescribeClusters", "ecs:ListServices"], "resources": ["arn"]}]},
      "resources": [
        {"type": "aws_ecs_cluster", "args": {"name": "$name", "tags": "$tags_named"},
         "module": "aws-ecs-cluster", "module_args": {"name": "$name", "create_cloudwatch_log_group": false, "configuration": null, "tags": "$tags_named"}}
      ]
    },
    "fargate": {
      "step": "compute", "category": "containers", "item": "ecs_service", "requires": "subnet", "security_group": true, "ci_access": {"statements": [{"actions": ["ecs:DescribeServices", "ecs:UpdateService"], "resources": ["id"]}, {"actions": ["ecs:DescribeTaskDefinition", "ecs:RegisterTaskDefinition"], "resources": ["*"]}]},
      "resources": [
        {"type": "aws_ecs_service", "args": {"name": "$name", "cluster": "$var:cluster_arn", "task_definition": "$var:task_definition_arn", "launch_type": "FARGATE", "desired_count": "$var:desired_count:number=1", "network_configuration": {"$block": {"subnets": "$subnets.id", "security_groups": "$security_groups", "assign_public_ip": false}}, "tags": "$tags_named"},
         "module": "aws-ecs-service", "module_args": {"name": "$name", "cluster_arn": "$var:cluster_arn", "create_task_definition": false, "task_definition_arn": "$var:task_definition_arn", "launch_type": "FARGATE", "desired_count": "$var:desired_count:number=1", "subnet_ids": "$subnets.id", "security_group_ids": "$security_groups", "assign_public_ip": false, "create_security_group": false, "enable_autoscaling": false, "tags": "$tags_named"}}
      ]
    },
    "elastic-kubernetes-service": {
      "step": "compute", "category": "containers", "item": "eks_cluster", "requires": "subnet", "security_group": true, "port": 443, "output": "endpoint", "ci_access": {"statements": [{"actions": ["eks:DescribeCluster"], "resources": ["arn"]}]},
      "resources": [
        {"type": "aws_eks_cluster", "args": {"name": "$name", "role_arn": "$var:cluster_role_arn", "vpc_config": {"$block": {"subnet_ids": "$subnets.id", "security_group_ids": "$security_groups"}}, "tags": "$tags_named"},
         "module": "aws-eks", "module_args": {"name": "$name", "iam_role_name": "$name:max32", "vpc_id": "$network.id", "subnet_ids": "$subnets.id", "endpoint_public_access": true, "create_security_group": false, "additional_security_group_ids": "$security_groups", "create_node_security_group": false, "enable_cluster_creator_admin_permissions": true, "create_kms_key": false, "encryption_config": null, "tags": "$tags_named"}}
      ]
    },
    "lambda": {
